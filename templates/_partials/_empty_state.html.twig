<div class="flex h-full flex-col items-center justify-center gap-3 px-6 py-10 text-center">
    <div class="rounded-full bg-bg-elevated p-4 text-text-muted">
        {{ icon|default('💬') }}
    </div>
    <h3 class="text-lg font-semibold text-text-secondary">{{ title }}</h3>
    <p class="max-w-sm text-sm text-text-muted">{{ subtitle }}</p>
    {% if ctaLabel is defined and ctaHref is defined %}
        <a href="{{ ctaHref }}" class="ui-btn-primary">{{ ctaLabel }}</a>
    {% endif %}
</div>
