{% macro wrapper(id, title, body, footer) %}
    <div id="{{ id }}" class="modal-backdrop hidden" data-controller="modal" data-modal-target="dialog">
        <div class="modal-card">
            <div class="flex items-center justify-between border-b border-border-subtle px-4 py-3">
                <h3 class="text-lg font-semibold text-text-primary">{{ title }}</h3>
                <button type="button" class="ui-icon-btn" data-action="click->modal#close" aria-label="Fermer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
            <div class="px-4 py-4">{{ body|raw }}</div>
            <div class="flex justify-end gap-2 border-t border-border-subtle px-4 py-3">{{ footer|raw }}</div>
        </div>
    </div>
{% endmacro %}
