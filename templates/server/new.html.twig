{% extends 'base.html.twig' %}

{% block title %}Nouveau serveur{% endblock %}

{% block body %}
    <main class="mx-auto flex min-h-[calc(100vh-3rem)] max-w-xl items-center px-4">
        <section class="ui-card w-full p-6">
        <h1 class="text-2xl font-bold text-text-primary">Créer un serveur</h1>
        <p class="mt-1 text-sm text-text-muted">Donne un nom à ton espace.</p>
        {{ form_start(form, { attr: { class: 'mt-5 space-y-4' } }) }}
            {{ form_row(form.name) }}
            <button type="submit" class="ui-btn-primary">Créer</button>
        {{ form_end(form) }}
        </section>
    </main>
{% endblock %}
